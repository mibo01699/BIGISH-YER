# 1. إعدادات الخادم والبيئة الرئيسية
PORT=5000
NODE_ENV=development

# 2. مفتاح الذكاء الاصطناعي الخاص بـ OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. إعدادات بوابة مطوري شبكة Pi Network
PI_API_KEY=pbk_your_secret_pi_core_team_developer_key_here
PI_BLOCKCHAIN_NETWORK=testnet

# 4. إعدادات قاعدة بيانات ليدجر المقاصة والمحافظ
DATABASE_URL=postgresql://user:password@localhost:5432/bigish_yer_ledger
DATABASE_ENCRYPTION_KEY=64_character_hex_string_for_production_safety_key

# 5. حدود الاستقرار المالي والاحياطي لـ YER
YER_STABILIZATION_RESERVE_LIMIT=10000000
