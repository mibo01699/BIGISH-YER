# ---------------------------------------------------------------
# BIGISH-YER runtime configuration
# Copy to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# CORS: comma-separated list of allowed browser origins
ALLOWED_ORIGINS=https://arabian-eagle-aec-gateway.vercel.app,http://localhost:3000

# Public URL reported by GET /api/apps
PUBLIC_APP_URL=https://bigish-yer.vercel.app

# Rate limiting (defaults: 100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Shared secret for sensitive endpoints (POST /api/transfer). Generate with:
#   openssl rand -hex 32
# If left empty the sensitive endpoints respond 503 (disabled).
API_KEY=

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Pi Network (keep PI_SANDBOX=true until PI_INTEGRATION.md checklist is complete)
PI_SANDBOX=true
PI_API_URL=https://api.minepi.com
PI_API_KEY=
PI_BLOCKCHAIN_NETWORK=testnet

# YER tokenomics (canonical values, see YERTokenomicsCanonical.js)
YER_MAX_SUPPLY=300000000
YER_COMMUNITY_ALLOCATION=30000000
YER_ECOSYSTEM_ALLOCATION=90000000
YER_RESERVE_ALLOCATION=180000000
YER_LAUNCHPAD_STATUS=PENDING

# Ledger database (not yet wired into the API)
DATABASE_URL=postgresql://user:password@localhost:5432/bigish_yer_ledger
DATABASE_ENCRYPTION_KEY=64_character_hex_string_for_production_safety_key

# Optional AI provider
OPENROUTER_API_KEY=
