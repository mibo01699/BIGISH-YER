# ============================================================
# BIGISH-YER Environment Configuration (Sandbox / Testnet)
# لا تقم بإدخال أي مفاتيح حقيقية هنا - هذا الملف للتوضيح فقط
# ============================================================

# 1. إعدادات الخادم والبيئة الرئيسية
PORT=5000
NODE_ENV=development

# 2. (اختياري) مفتاح الذكاء الاصطناعي - يمكن استخدامه لخدمات مساعدة
OPENROUTER_API_KEY=

# 3. إعدادات قاعدة بيانات ليدجر المقاصة والمحافظ
DATABASE_URL=postgresql://user:password@localhost:5432/bigish_yer_ledger
DATABASE_ENCRYPTION_KEY=64_character_hex_string_for_production_safety_key

# 4. إعدادات YER الاقتصادية الإلزامية (مطابقة للمصدر المركزي)
YER_MAX_SUPPLY=300000000
YER_COMMUNITY_ALLOCATION=30000000
YER_ECOSYSTEM_ALLOCATION=90000000
YER_RESERVE_ALLOCATION=180000000

# 5. إعدادات بيئة التشغيل (Sandbox)
PI_BLOCKCHAIN_NETWORK=testnet
