# استخدام بيئة Node.js مستقرة وخفيفة للأنظمة المالية
FROM node:18-alpine

# تحديد مجلد العمل داخل الحاوية
WORKDIR /usr/src/app

# نسخ ملفات التكوين البرمجية الحالية
COPY package*.json ./

# تثبيت الاعتمادات للإنتاج فقط لتوفير المساحة وزيادة الأمان
RUN npm ci --only=production

# نسخ كافة ملفات النظام البيئي المحوكم (الـ AMM، المحرك الديناميكي، العقود الذكية)
COPY . .

# فتح المنفذ الخاص بالـ API (متاح لجميع التطبيقات)
EXPOSE 3000

# تشغيل الخادم الرئيسي المعتمد (app.js وليس server.js)
CMD ["node", "app.js"]