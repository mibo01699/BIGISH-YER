{ pkgs }: {
  deps = [
    # 1. بيئة التشغيل الأساسية (أولوية قصوى)
    pkgs.nodejs-18_x

    # 2. أدوات التحكم بالإصدارات (أولوية عالية - لإدارة Git داخل Replit)
    pkgs.git

    # 3. أداة التشفير والأمان (أولوية عالية - لدعم cryptoEngine.js)
    pkgs.openssl

    # 4. بيئة بايثون للمحاكاة الاقتصادية (ضروري - لتشغيل simulation.py)
    pkgs.python3

    # 5. بيئة سطر الأوامر (أولوية أساسية - لتنفيذ السكربتات)
    pkgs.bash
  ];
}