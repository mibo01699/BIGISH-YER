// suppliers-auction/backend/auction-clearing.js
// محرك المقاصة وتنظيم المزايدات الصناعية وحماية الموردين (Strict BigInt Architecture)

const AntiDoubleDippingEngine = require('../../AntiDoubleDippingEngine');
const PiPaymentProcessor = require('../../backend/PiPaymentProcessor'); // تصحيح المسار
const YER_TOKENOMICS = require('../../YERTokenomicsCanonical'); // المصدر المركزي

class AuctionClearingNode {
    constructor() {
        // مصفوفة حفظ المزادات الصناعية
        this.activeAuctions = new Map();
    }

    /**
     * إنشاء مزاد توريد صناعي جديد
     */
    createNewAuction(auctionId, title, institutionId, reservePriceYer) {
        this.activeAuctions.set(auctionId, {
            title,
            institutionId,
            reservePriceYer: BigInt(reservePriceYer),
            bids: [],
            status: "OPEN_FOR_BIDDING",
            createdAt: Date.now()
        });
        console.log(`[عقود صناعية] تم فتح المزاد رقم ${auctionId} بنجاح.`);
    }

    /**
     * تسجيل عرض سعر (Bid) مقدم من مورد رسمي
     */
    submitSupplierBid(auctionId, supplierId, bidAmountYer, exchangeRate, bidNonce) {
        const auction = this.activeAuctions.get(auctionId);
        if (!auction) throw new Error("المزاد الصناعي غير موجود.");
        if (auction.status !== "OPEN_FOR_BIDDING") throw new Error("المزاد مغلق.");

        // 1. تشغيل صمام الأمان ضد التكرار
        AntiDoubleDippingEngine.acquireAtomicLock(supplierId, bidNonce);

        try {
            const totalBidBig = BigInt(bidAmountYer);

            // 2. التحقق من عدم تجاوز السقف الأقصى 300M
            if (totalBidBig > YER_TOKENOMICS.maximumSupply) {
                throw new Error("SUPPLY_CAP_ERROR: Bid exceeds 300M YER Maximum Supply.");
            }

            // 3. معالجة المقاصة الهجينة
            const splitResults = PiPaymentProcessor.processHybridInvoice(totalBidBig.toString(), exchangeRate);

            const compiledBid = {
                supplierId,
                bidNonce,
                totalAmountYer: totalBidBig.toString(),
                splitMatrix: {
                    localReserveYer: splitResults.yerSovereignUnits,
                    cryptoStroops: splitResults.piStroops
                },
                timestamp: Date.now()
            };

            auction.bids.push(compiledBid);
            console.log(`[عطاءات الموردين] تم قبول عطاء المورد ${supplierId} بنجاح.`);
            
            return { success: true, message: "تم تسجيل العطاء ومطابقته لشروط المقاصة." };
        } catch (error) {
            console.error(`[فشل العطاء] خطأ: ${error.message}`);
            throw error;
        } finally {
            // 4. تحرير القفل بالوسيطين الصحيحين
            AntiDoubleDippingEngine.releaseLock(supplierId, bidNonce);
        }
    }

    /**
     * إغلاق المزاد وإرساء العقد رسمياً
     */
    finalizeAuctionAndLockEscrow(auctionId) {
        const auction = this.activeAuctions.get(auctionId);
        if (!auction || auction.bids.length === 0) {
            throw new Error("لا يمكن إغلاق مزاد فارغ.");
        }

        auction.status = "COMPLETED_AND_LOCKED";

        // اختيار العطاء الأقل تكلفة (أو الأول كونه الأفضل في هذا النموذج)
        const winningBid = auction.bids[0];
        auction.winningBid = winningBid;

        console.log(`[إرساء صناعي] تم إرساء المزاد ${auctionId} على المورد ${winningBid.supplierId}.`);
        return {
            auctionId,
            winner: winningBid.supplierId,
            clearingMatrix: winningBid.splitMatrix,
            status: "ESCROW_MANIFEST_READY_FOR_SETTLEMENT" // إزالة ادعاء Pi Browser
        };
    }
}

module.exports = new AuctionClearingNode();