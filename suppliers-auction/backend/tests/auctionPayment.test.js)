/**
 * BIGISH-YER: Hybrid Auction Settlement Security & Validation Tests
 * NOTE: Sandbox/Testnet validation only. No claims of official Pi Network integration.
 */

const chai = require('chai');
const { expect } = chai;

// استيراد المحركات الفعلية الموجودة في المستودع
const AntiDoubleDippingEngine = require('../../../AntiDoubleDippingEngine');
const DynamicRatioValidator = require('../../../DynamicRatioValidator');

describe('🔨 BIGISH-YER: Hybrid Auction Security Logic Tests', () => {

    beforeEach(() => {
        // تنظيف حالة الأقفال قبل كل اختبار لضمان عزل تام
        // (هذا يعتمد على طريقة تنفيذ AntiDoubleDippingEngine الحالية)
        // ملاحظة: في النسخة الحالية، الكلاس يُصدّر كـ Singleton، لذلك نعيد تهيئته يدويًا
        // إذا لزم الأمر، أو نكتفي بالمنطق المنطقي.
    });

    /**
     * الاختبار الأول: التحقق من نجاح تقسيم الدفع الهجين (BigInt)
     */
    it('1. Should SUCCESSFULLY split hybrid payment when amounts are strings', () => {
        const validator = new DynamicRatioValidator();
        
        // استخدام السلاسل النصية لمنع الأخطاء العائمة
        const totalAmount = "1000"; // إجمالي الفاتورة
        const piPercentage = 10;
        const yerPercentage = 90;

        const result = validator.validateAndSplit(BigInt(totalAmount), piPercentage, yerPercentage);

        expect(result).to.have.property('piPaymentStroops').that.is.a('string');
        expect(result).to.have.property('yerPaymentSubUnits').that.is.a('string');
        expect(result.piRatio).to.equal(10);
        expect(result.yerRatio).to.equal(90);
        // التأكد من أن المجموع يساوي 100% (التحقق من النسب)
        expect(piPercentage + yerPercentage).to.equal(100);
    });

    /**
     * الاختبار الثاني: حظر إعادة استخدام نفس الـ Nonce لمنع الإنفاق المزدوج
     */
    it('2. Should BLOCK duplicate requests for the same claim (Anti-Double Dipping Check)', () => {
        const entityId = "auction_item_9900";
        const claimNonce = "pay_auction_valid_777";

        // القفل الأول يجب أن ينجح
        const firstLock = AntiDoubleDippingEngine.acquireAtomicLock(entityId, claimNonce);
        expect(firstLock).to.equal(true);

        // المحاولة الثانية لنفس الـ Nonce يجب أن ترفض
        try {
            AntiDoubleDippingEngine.acquireAtomicLock(entityId, claimNonce);
            // إذا وصلنا هنا، فهذا يعني أن الاختبار فشل لأنه لم يتم رمي خطأ
            expect.fail("Expected an error to be thrown for duplicate nonce");
        } catch (error) {
            expect(error.message).to.include("REPLAY_PROTECTION");
        }

        // تحرير القفل لتنظيف الحالة
        AntiDoubleDippingEngine.releaseLock(entityId, claimNonce);
    });
});