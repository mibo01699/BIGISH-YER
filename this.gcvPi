-- ====================================================================
--  Visa Cards Issuance & Zero-Loss Rotation Database Schema
--  منظومة النسر العربي (A.E.C.) - البنية التحتية لمستودع BIGISH-YER
-- ====================================================================

-- 1. جدول حسابات المستخدمين ومعرفاتهم المشفرة المربوطة بالـ KYC للبلوكشين
CREATE TABLE IF NOT EXISTS Users (
    user_id VARCHAR(255) PRIMARY KEY,
    wallet_address VARCHAR(255) NOT NULL,
    registered_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. جدول بطاقات فيزا كارد الافتراضية الصادرة للمشتركين (سنة، سنتين، ثلاث سنوات)
CREATE TABLE IF NOT EXISTS VisaCards (
    card_id VARCHAR(255) PRIMARY KEY,
    user_id VARCHAR(255) NOT NULL,
    provider_name VARCHAR(100) DEFAULT 'Visa International',
    duration_years INT NOT NULL, -- 1, 2, or 3 years
    card_status VARCHAR(50) DEFAULT 'ACTIVE', -- ACTIVE, SUSPENDED, EXPIRED
    issued_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    pi_profit_gcv_paid VARCHAR(100) NOT NULL, -- قيمة أرباح الـ 5% المدفوعة بـ Pi عند الشراء الأول
    FOREIGN KEY (user_id) REFERENCES Users(user_id)
);

-- 3. جدول عمليات التغذية والشحن الفوري للبطاقات (دفع فردي بـ YER وصفر أرباح)
CREATE TABLE IF NOT EXISTS VisaTransactions (
    tx_id VARCHAR(255) PRIMARY KEY,
    card_id VARCHAR(255) NOT NULL,
    user_id VARCHAR(255) NOT NULL,
    transaction_type VARCHAR(50) NOT NULL, -- 'INITIAL_PURCHASE' or 'INSTANT_RELOAD'
    amount_usd DECIMAL(18, 2) NOT NULL,    -- المبلغ المطلوب بالدولار لشحن البطاقة
    paid_amount_yer VARCHAR(100) NOT NULL, -- القيمة المخصومة برمز YER وفق سعر مجمع السيولة الشامل لرسوم السحب
    rotated_usdt VARCHAR(100) NOT NULL,    -- المبلغ المدور بالدولار الرقمي والمحول لكاش ورقي لحساب الشركة
    processed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (card_id) REFERENCES VisaCards(card_id),
    FOREIGN KEY (user_id) REFERENCES Users(user_id)
);
