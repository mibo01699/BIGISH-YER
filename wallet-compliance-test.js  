// tests/wallet-compliance.test.js
// Wallet and Clearing Automation System Integration Audit
// Verification Focus: Absolute BigInt Verification across 11 Global Languages
const { test, describe } = require('node:test');
const assert = require('node:assert');

// Mock Wallet Ai Support System
class MockWalletAiSupportSystem {
    consultWalletAi(message, amount, lang) {
        if (typeof amount !== 'string' || amount.includes('.')) {
            return { integerHexToken: "FAULT", aiMessageText: "Floating point detected!" };
        }
        return { integerHexToken: BigInt(amount).toString(16), aiMessageText: "AI Core Diagnosis: All units integer-based." };
    }
    openHumanSupportTicket(walletRef, amount, msg) {
        return { id: "TKT-" + Date.now(), status: "OPEN" };
    }
}

const walletAuditNode = new MockWalletAiSupportSystem();

describe('Wallet Support and AI Core Strict Compliance Audit', () => {
    test('should pass all verification checks without floating point errors', () => {
        const walletTestCases = [
            { lang: "ar", node: "Yemen Central Node", amount: "250007500000000" },
            { lang: "zh", node: "China Regional Node", amount: "888880000000000" },
            { lang: "tr", node: "Turkey Trade Gateway", amount: "14531000000000" }
        ];

        walletTestCases.forEach((test) => {
            console.log(`Running System Diagnostics for: [${test.node}] - Language: (${test.lang})`);

            const aiReport = walletAuditNode.consultWalletAi("Audit batch ledger allocation", test.amount, test.lang);
            
            // 1. التأكد من أن المبلغ نص صحيح (بدون كسور عشرية)
            assert.strictEqual(typeof test.amount, 'string', `Amount for ${test.lang} must be a string`);
            assert.ok(!test.amount.includes('.'), `Floating point trace detected in amount for ${test.lang}!`);
            
            // 2. التأكد من أن التقرير الناتج سليم (ليس FAULT)
            assert.notStrictEqual(aiReport.integerHexToken, "FAULT", `CRITICAL FAULT: AI rejected unsafe decimal input for ${test.lang}!`);
            assert.ok(!aiReport.integerHexToken.includes('.'), `Floating point trace leaked into AI analysis for ${test.lang}!`);
            
            console.log(`-> AI Core Diagnosis Result: ${aiReport.aiMessageText}`);

            // 3. التأكد من أن تذكرة الدعم فُتحت بنجاح
            const ticket = walletAuditNode.openHumanSupportTicket("GDV...WALLET...REF", 40302n, "Lock conflict remediation check");
            assert.strictEqual(ticket.status, "OPEN", `Human escalation ticket creation failed for ${test.lang}!`);
            console.log(`-> Human Escalation Pipeline Ticket Created: [${ticket.id}] - Status: ${ticket.status}`);
        });
    });
});